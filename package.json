{
  "name": "jurisone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:migrate": "node scripts/mvnw.mjs -q spring-boot:run -Dspring-boot.run.arguments=migrate",
    "db:seed": "node scripts/mvnw.mjs -q spring-boot:run -Dspring-boot.run.arguments=seed",
    "db:reset": "node scripts/mvnw.mjs -q spring-boot:run -Dspring-boot.run.arguments=reset",
    "backend:dev": "node scripts/mvnw.mjs -q spring-boot:run",
    "backend:test": "node scripts/mvnw.mjs -B test",
    "backend:up": "docker compose up -d --build backend",
    "jobs": "node scripts/mvnw.mjs -q spring-boot:run -Dspring-boot.run.arguments=jobs"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "country-flag-icons": "^1.6.20",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pg": "^8.23.1",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
