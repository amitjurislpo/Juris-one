# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: the real ones (.env.dev/.sqe/.uat/.prd) hold secrets and are never committed; the templates live in backend/src/main/resources/
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# app
/storage/
/test-results/
/playwright-report/

# local tooling
/.vscode/
/.claude/worktrees/
