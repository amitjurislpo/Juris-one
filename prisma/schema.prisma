// JurisOne — HRMS + payroll for Juris Consultants.
// Conventions: every timestamp is timestamptz (UTC); calendar dates are `date`;
// money is integer paise (Int for monthly figures, BigInt for annual figures).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── enums ─────────────────────────

enum EmployeeStatus {
  ONBOARDING
  PROBATION
  ACTIVE
  EXITED
}

enum Region {
  IN
  US
}

enum HolidayRegion {
  IN
  US
  ALL
}

enum PunchKind {
  IN
  OUT
}

enum PunchSource {
  WEB
  MOBILE
  REGULARIZATION
}

enum DayStatus {
  PRESENT
  HALF_DAY
  ABSENT
  LEAVE
  HOLIDAY
  WEEKLY_OFF
  BEFORE_JOINING
  AFTER_EXIT
  PENDING
}

enum RegularizationKind {
  ABSENT
  LATE_CHECKIN
  MISSED_CHECKOUT
  HOLIDAY_WORK
}

enum RequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum LeavePart {
  FULL
  FIRST_HALF
  SECOND_HALF
}

enum LedgerReason {
  ACCRUAL
  USED
  CANCELLED
  ENCASHED
  EXPIRED
  ADJUSTMENT
  CARRY_FORWARD
  COMP_OFF_CREDIT
}

enum PayrollStatus {
  OPEN
  CLOSED
}

enum PayrollStage {
  LOCK_ATTENDANCE
  COMPUTE
  REVIEW
  APPROVED
  CLOSED
}

enum StructureReason {
  JOINING
  APPRAISAL
  PROMOTION
  CORRECTION
}

enum TaxRegime {
  NEW
  OLD
}

enum DeclarationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum AuthTokenPurpose {
  INVITE
  RESET
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  LOGGED
}

// ───────────────────── org & access ─────────────────────

model Department {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @unique
  headEmployeeId String?   @map("head_employee_id") @db.Uuid
  description    String?
  createdById    String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  head      Employee?  @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  createdBy Employee?  @relation("DepartmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  employees Employee[] @relation("EmployeeDepartment")

  @@map("departments")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  name      String   @unique
  isBuiltin Boolean  @default(false) @map("is_builtin")
  isLocked  Boolean  @default(false) @map("is_locked") // Admin role: permissions cannot be edited
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  assignable  RoleAssignableRole[] @relation("RoleAssigner")
  assignedBy  RoleAssignableRole[] @relation("RoleAssignee")
  employees   Employee[]

  @@map("roles")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model RoleAssignableRole {
  roleId           String @map("role_id") @db.Uuid
  assignableRoleId String @map("assignable_role_id") @db.Uuid

  role           Role @relation("RoleAssigner", fields: [roleId], references: [id], onDelete: Cascade)
  assignableRole Role @relation("RoleAssignee", fields: [assignableRoleId], references: [id], onDelete: Cascade)

  @@id([roleId, assignableRoleId])
  @@map("role_assignable_roles")
}

model Shift {
  id             String  @id @default(uuid()) @db.Uuid
  code           String  @unique // IN_NIGHT · IN_DAY · US_DAY
  name           String
  startLocal     String  @map("start_local") // "19:30" in the employee's own zone
  endLocal       String  @map("end_local") // "04:30"
  graceMinutes   Int     @default(15) @map("grace_minutes")
  region         Region
  crossesMidnight Boolean @default(false) @map("crosses_midnight")

  employees Employee[]

  @@map("shifts")
}

model Employee {
  id                 String         @id @default(uuid()) @db.Uuid
  code               String         @unique // JC-###
  fullName           String         @map("full_name")
  fatherName         String?        @map("father_name")
  email              String         @unique // stored lower-case
  // PII — AES-256-GCM ciphertext; *_last4 kept for masked display
  phoneEnc           String?        @map("phone_enc")
  phoneLast4         String?        @map("phone_last4")
  addressEnc         String?        @map("address_enc")
  panEnc             String?        @map("pan_enc")
  panLast4           String?        @map("pan_last4")
  aadhaarEnc         String?        @map("aadhaar_enc")
  aadhaarLast4       String?        @map("aadhaar_last4")
  uanEnc             String?        @map("uan_enc")
  uanLast4           String?        @map("uan_last4")
  bankAccountEnc     String?        @map("bank_account_enc")
  bankAccountLast4   String?        @map("bank_account_last4")
  bankIfsc           String?        @map("bank_ifsc")
  bankName           String?        @map("bank_name")
  departmentId       String?        @map("department_id") @db.Uuid
  designation        String
  reportingManagerId String?        @map("reporting_manager_id") @db.Uuid
  roleId             String         @map("role_id") @db.Uuid
  dateOfJoining      DateTime       @map("date_of_joining") @db.Date
  exitDate           DateTime?      @map("exit_date") @db.Date
  status             EmployeeStatus @default(ONBOARDING)
  timeZone           String         @map("time_zone") // IANA, e.g. Asia/Kolkata
  region             Region
  shiftId            String?        @map("shift_id") @db.Uuid
  portalAccess       Boolean        @default(true) @map("portal_access")
  createdById        String?        @map("created_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  department       Department?  @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  reportingManager Employee?    @relation("Reports", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports    Employee[]   @relation("Reports")
  role             Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  shift            Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdBy        Employee?    @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  created          Employee[]   @relation("EmployeeCreatedBy")
  headOf           Department[] @relation("DepartmentHead")
  departmentsMade  Department[] @relation("DepartmentCreatedBy")

  user               User?
  sessions           Session[]
  loginHistory       LoginHistory[]
  authTokens         AuthToken[]
  punches            Punch[]
  attendanceDays     AttendanceDay[]
  regularizations    RegularizationRequest[] @relation("RegEmployee")
  regDecisions       RegularizationRequest[] @relation("RegDecider")
  holidaysAdded      Holiday[]
  leaveLedger        LeaveLedger[]           @relation("LedgerEmployee")
  leaveRequests      LeaveRequest[]          @relation("LeaveEmployee")
  leaveDecisions     LeaveRequest[]          @relation("LeaveDecider")
  salaryStructures   SalaryStructure[]       @relation("StructureEmployee")
  structuresCreated  SalaryStructure[]       @relation("StructureCreatedBy")
  payrollAdjustments PayrollAdjustment[]     @relation("AdjEmployee")
  adjustmentsMade    PayrollAdjustment[]     @relation("AdjUpdatedBy")
  payslips           Payslip[]
  taxProfiles        TaxProfile[]
  declarationItems   DeclarationItem[]       @relation("DeclEmployee")
  declDecisions      DeclarationItem[]       @relation("DeclDecider")
  notifications      Notification[]
  auditEntries       AuditLog[]
  runsClosed         PayrollRun[]            @relation("RunClosedBy")
  runsApproved       PayrollRun[]            @relation("RunApprovedBy")

  @@index([departmentId])
  @@index([reportingManagerId])
  @@index([roleId])
  @@index([status])
  @@map("employees")
}

model User {
  employeeId     String    @id @map("employee_id") @db.Uuid
  passwordHash   String?   @map("password_hash") // argon2id; null until invite accepted
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordSetAt  DateTime? @map("password_set_at") @db.Timestamptz(6)
  isSuperAdmin   Boolean   @default(false) @map("is_super_admin")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Session {
  id            String    @id // sha256(token) — the raw token only lives in the cookie
  employeeId    String    @map("employee_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ip            String?
  userAgent     String?   @map("user_agent")
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("sessions")
}

model LoginHistory {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String?  @map("employee_id") @db.Uuid
  identifier String
  success    Boolean
  reason     String?
  ip         String?
  userAgent  String?  @map("user_agent")
  at         DateTime @default(now()) @db.Timestamptz(6)

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId, at])
  @@index([ip, at])
  @@map("login_history")
}

model AuthToken {
  id         String           @id @default(uuid()) @db.Uuid
  tokenHash  String           @unique @map("token_hash")
  employeeId String           @map("employee_id") @db.Uuid
  purpose    AuthTokenPurpose
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, purpose])
  @@map("auth_tokens")
}

// ───────────────────── attendance ─────────────────────

model Punch {
  id         String      @id @default(uuid()) @db.Uuid
  employeeId String      @map("employee_id") @db.Uuid
  at         DateTime    @db.Timestamptz(6)
  kind       PunchKind
  source     PunchSource @default(WEB)
  ip         String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, at])
  @@map("punches")
}

model AttendanceDay {
  employeeId    String    @map("employee_id") @db.Uuid
  workDate      DateTime  @map("work_date") @db.Date // shift start date, employee's zone
  status        DayStatus
  firstIn       DateTime? @map("first_in") @db.Timestamptz(6)
  lastOut       DateTime? @map("last_out") @db.Timestamptz(6)
  workedMinutes Int       @default(0) @map("worked_minutes")
  late          Boolean   @default(false)
  lateWaived    Boolean   @default(false) @map("late_waived")
  regularized   Boolean   @default(false)
  locked        Boolean   @default(false)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, workDate])
  @@index([workDate])
  @@map("attendance_days")
}

model RegularizationRequest {
  id          String             @id @default(uuid()) @db.Uuid
  employeeId  String             @map("employee_id") @db.Uuid
  workDate    DateTime           @map("work_date") @db.Date
  kind        RegularizationKind
  proposedIn  DateTime?          @map("proposed_in") @db.Timestamptz(6)
  proposedOut DateTime?          @map("proposed_out") @db.Timestamptz(6)
  reason      String?
  status      RequestStatus      @default(PENDING)
  decidedById String?            @map("decided_by") @db.Uuid
  decidedAt   DateTime?          @map("decided_at") @db.Timestamptz(6)
  decidedRole String?            @map("decided_role")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  employee  Employee  @relation("RegEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy Employee? @relation("RegDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([employeeId, workDate])
  @@map("regularization_requests")
}

model Holiday {
  id          String        @id @default(uuid()) @db.Uuid
  date        DateTime      @db.Date
  name        String
  region      HolidayRegion
  createdById String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy Employee? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([date, region])
  @@map("holidays")
}

// ───────────────────── leave ─────────────────────

model LeaveType {
  code              String  @id // CL · EL · CO · LOP
  name              String
  annualQuota       Decimal @default(0) @map("annual_quota") @db.Decimal(5, 2)
  accrualPerMonth   Decimal @default(0) @map("accrual_per_month") @db.Decimal(5, 2)
  carryForwardCap   Decimal @default(0) @map("carry_forward_cap") @db.Decimal(5, 2)
  maxStretch        Decimal? @map("max_stretch") @db.Decimal(5, 2)
  encashPerYear     Decimal @default(0) @map("encash_per_year") @db.Decimal(5, 2)
  encashAfterMonths Int     @default(0) @map("encash_after_months")
  expiryDays        Int?    @map("expiry_days")
  paid              Boolean @default(true)
  needsBalance      Boolean @default(true) @map("needs_balance")
  sortOrder         Int     @default(0) @map("sort_order")
  active            Boolean @default(true)

  ledger   LeaveLedger[]
  requests LeaveRequest[]

  @@map("leave_types")
}

model LeaveLedger {
  id          String       @id @default(uuid()) @db.Uuid
  employeeId  String       @map("employee_id") @db.Uuid
  leaveType   String       @map("leave_type")
  delta       Decimal      @db.Decimal(6, 2)
  reason      LedgerReason
  refId       String?      @map("ref_id")
  note        String?
  expiresOn   DateTime?    @map("expires_on") @db.Date // comp-off credits
  at          DateTime     @default(now()) @db.Timestamptz(6)

  employee Employee  @relation("LedgerEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  type     LeaveType @relation(fields: [leaveType], references: [code])

  @@index([employeeId, leaveType])
  @@map("leave_ledger")
}

model LeaveRequest {
  id          String        @id @default(uuid()) @db.Uuid
  employeeId  String        @map("employee_id") @db.Uuid
  leaveType   String        @map("leave_type")
  fromDate    DateTime      @map("from_date") @db.Date
  toDate      DateTime      @map("to_date") @db.Date
  part        LeavePart     @default(FULL)
  days        Decimal       @db.Decimal(5, 2)
  lopDays     Decimal       @default(0) @map("lop_days") @db.Decimal(5, 2)
  reason      String?
  status      RequestStatus @default(PENDING)
  decidedById String?       @map("decided_by") @db.Uuid
  decidedAt   DateTime?     @map("decided_at") @db.Timestamptz(6)
  appliedAt   DateTime      @default(now()) @map("applied_at") @db.Timestamptz(6)

  employee  Employee  @relation("LeaveEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy Employee? @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  type      LeaveType @relation(fields: [leaveType], references: [code])

  @@index([status])
  @@index([employeeId, fromDate])
  @@map("leave_requests")
}

// ───────────────────── payroll ─────────────────────

model SalaryStructure {
  id            String          @id @default(uuid()) @db.Uuid
  employeeId    String          @map("employee_id") @db.Uuid
  effectiveFrom DateTime        @map("effective_from") @db.Date
  basic         Int // monthly, paise
  hra           Int
  lta           Int
  special       Int
  reason        StructureReason
  createdById   String?         @map("created_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  employee  Employee  @relation("StructureEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy Employee? @relation("StructureCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([employeeId, effectiveFrom])
  @@map("salary_structures")
}

model PayrollRun {
  id                 String        @id @default(uuid()) @db.Uuid
  month              String        @unique // "2026-09"
  status             PayrollStatus @default(OPEN)
  stage              PayrollStage  @default(LOCK_ATTENDANCE)
  attendanceLockedAt DateTime?     @map("attendance_locked_at") @db.Timestamptz(6)
  computedAt         DateTime?     @map("computed_at") @db.Timestamptz(6)
  approvedById       String?       @map("approved_by") @db.Uuid
  approvedAt         DateTime?     @map("approved_at") @db.Timestamptz(6)
  closedById         String?       @map("closed_by") @db.Uuid
  closedAt           DateTime?     @map("closed_at") @db.Timestamptz(6)
  payDate            DateTime?     @map("pay_date") @db.Date
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  approvedBy  Employee?           @relation("RunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  closedBy    Employee?           @relation("RunClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  adjustments PayrollAdjustment[]
  payslips    Payslip[]

  @@map("payroll_runs")
}

model PayrollAdjustment {
  runId          String   @map("run_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  lopDays        Decimal? @map("lop_days") @db.Decimal(5, 2) // null = use attendance
  bonus          Int      @default(0) // paise
  otherDeduction Int      @default(0) @map("other_deduction")
  note           String?
  updatedById    String?  @map("updated_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  run       PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee  Employee   @relation("AdjEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  updatedBy Employee?  @relation("AdjUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@id([runId, employeeId])
  @@map("payroll_adjustments")
}

model Payslip {
  runId       String   @map("run_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  snapshot    Json // immutable once the run is closed
  pdfPath     String?  @map("pdf_path")
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([runId, employeeId])
  @@map("payslips")
}

// ───────────────────── tax ─────────────────────

model TaxYear {
  fy             String    // "2026-27"
  regime         TaxRegime
  stdDeduction   Int       @map("std_deduction") // rupees
  rebateLimit    Int       @map("rebate_limit") // rupees; full rebate at or below
  marginalRelief Boolean   @default(false) @map("marginal_relief")
  cessRate       Decimal   @map("cess_rate") @db.Decimal(5, 4)
  slabs          Json // [{ upto: number|null, rate: number }]
  surcharge      Json // [{ above: number, rate: number }]

  @@id([fy, regime])
  @@map("tax_years")
}

model TaxSection {
  fy        String
  key       String // HRA · 80C · 80CCD1B · 80D_SELF · ...
  label     String // configurable section label (Income-tax Act, 2025 renumbering)
  cap       Int? // rupees; null = no cap
  sortOrder Int    @default(0) @map("sort_order")

  @@id([fy, key])
  @@map("tax_sections")
}

model TaxProfile {
  employeeId         String    @map("employee_id") @db.Uuid
  fy                 String
  regime             TaxRegime @default(NEW)
  regimeOverridden   Boolean   @default(false) @map("regime_overridden")
  metro              Boolean   @default(false)
  prevEmployerIncome BigInt    @default(0) @map("prev_employer_income") // paise
  prevEmployerTds    BigInt    @default(0) @map("prev_employer_tds") // paise
  landlordPan        String?   @map("landlord_pan")
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, fy])
  @@map("tax_profiles")
}

model DeclarationItem {
  id            String            @id @default(uuid()) @db.Uuid
  employeeId    String            @map("employee_id") @db.Uuid
  fy            String
  section       String
  itemKey       String            @map("item_key")
  amount        BigInt            @default(0) // paise
  proofPath     String?           @map("proof_path")
  proofName     String?           @map("proof_name")
  status        DeclarationStatus @default(DRAFT)
  decidedById   String?           @map("decided_by") @db.Uuid
  decidedAt     DateTime?         @map("decided_at") @db.Timestamptz(6)
  rejectReason  String?           @map("reject_reason")
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee  Employee  @relation("DeclEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy Employee? @relation("DeclDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, fy, itemKey])
  @@index([status])
  @@map("declaration_items")
}

// ───────────────────── platform ─────────────────────

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  text       String
  link       String?
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, readAt])
  @@map("notifications")
}

model AuditLog {
  id       String   @id @default(uuid()) @db.Uuid
  actorId  String?  @map("actor_id") @db.Uuid
  action   String // e.g. auth.login, employee.access_toggle
  entity   String
  entityId String?  @map("entity_id")
  before   Json?
  after    Json?
  at       DateTime @default(now()) @db.Timestamptz(6)
  ip       String?

  actor Employee? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_log")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model EmailOutbox {
  id        String      @id @default(uuid()) @db.Uuid
  to        String
  subject   String
  text      String
  html      String?
  status    EmailStatus @default(QUEUED)
  error     String?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt    DateTime?   @map("sent_at") @db.Timestamptz(6)

  @@index([status])
  @@map("email_outbox")
}
