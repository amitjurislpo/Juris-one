# ═══════════════════════════════════════════════════════════════════════════
# JurisOne — UAT: UAT - user acceptance testing (production-like)
# ═══════════════════════════════════════════════════════════════════════════
# One file per environment (.env.dev, .env.sqe, .env.uat, .env.prd). Nothing is shared between them: every
# environment has its own database, ports, secrets, email and storage. The real files are git-ignored;
# only these templates (backend/src/main/resources/<env>.env.template) are committed.
#
# Use: copy this file to the repository root as .env.uat, fill every <placeholder>, then
#   node scripts/with-env.mjs uat <command>   (see README → Environments)
# Variables already set in the real environment override this file.

APP_ENV="uat"
COMPOSE_PROJECT_NAME="jurisone-uat"   # separate containers and data volume per environment
ENV_FILE=".env.uat"

# ── Ports (each environment has its own, so they can run side by side) ──
BACKEND_PORT=8100    # Spring Boot API
DB_PORT=5456          # Postgres on the host

# ── Database (docker-compose creates it from these three; DATABASE_URL must use the same values) ──
POSTGRES_USER="jurisone"
POSTGRES_PASSWORD="<choose-a-strong-password>"
POSTGRES_DB="jurisone_uat"
DATABASE_URL="postgresql://jurisone:<choose-a-strong-password>@localhost:5456/jurisone_uat?schema=public"

# ── App ──
APP_NAME="JurisOne"
# The public URL of the app. The API accepts requests (Origin / CORS) only from here.
# https:// makes the session cookies Secure.
APP_URL="https://uat.people.example.com"

# ── Security ──
# 32 random bytes, base64. Encrypts PAN / Aadhaar / UAN / phone / address / bank account at rest.
# NEVER change it after data exists. Use a DIFFERENT key in every environment.
PII_ENCRYPTION_KEY="<generate: openssl rand -base64 32>"
# Signs the 5-minute JWT access tokens (HS256), at least 32 bytes. Use a DIFFERENT secret in every environment.
JWT_SECRET="<generate: openssl rand -base64 48>"
SESSION_TTL_DAYS=30

# ── Sign-in code (email OTP) ──
# Only dev may use a fixed code (000000). sqe, uat and prd MUST be empty: real random codes, emailed
# (the backend refuses to start otherwise). The identity provider (IAM JCG) replaces this later.
OTP_FIXED_CODE=""

# ── Seed (npm run db:seed) ──
SUPER_ADMIN_EMAIL="admin@jurislpo.com"
SUPER_ADMIN_PASSWORD="<choose-a-strong-password>"   # change it after the first sign-in
# Demo business with sample people: dev and sqe only. uat and prd must be "false".
SEED_DEMO="false"
SEED_OWNER_PASSWORD="<owner-password>"
SEED_DEMO_PASSWORD="<demo-password>"

# ── Email ──
# Required in this environment (sign-in codes and invites are emailed).
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="<smtp-user>"
SMTP_PASS="<smtp-password>"
MAIL_FROM="JurisOne (UAT) <no-reply@jurislpo.com>"

# ── Files ──
UPLOAD_DIR="./storage/uat"

# Background jobs (absence marking, monthly lock, status changes, leave accrual) run in the backend. "false" = run them from cron.
JOBS_ENABLED="true"
