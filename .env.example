# ── Database (docker-compose maps Postgres to host port 5436) ──
# docker-compose creates the database from these three; DATABASE_URL must use the same values.
POSTGRES_USER="jurisone"
POSTGRES_PASSWORD="<choose-a-strong-password>"
POSTGRES_DB="jurisone"
DATABASE_URL="postgresql://jurisone:<same-password>@localhost:5436/jurisone?schema=public"

# ── App ──
APP_NAME="JurisOne"
APP_URL="http://localhost:3005"
PORT=3005

# ── Security ──
# 32 random bytes, base64. Encrypts PAN / Aadhaar / UAN / phone / address / bank account at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER change this after data exists — encrypted fields become unreadable.
PII_ENCRYPTION_KEY=""
SESSION_TTL_DAYS=30

# ── Seed ──
SUPER_ADMIN_EMAIL="admin@jurislpo.com"
SUPER_ADMIN_PASSWORD="<choose-a-strong-password>"  # change it again after the first sign-in
# Password given to every demo employee (JC-002, JC-004, ...). Leave empty to skip demo passwords (they must use invite links).
SEED_DEMO_PASSWORD="<demo-password>"

# ── Email (leave SMTP_HOST empty in dev: emails are written to the email_outbox table and the server log) ──
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="JurisOne <no-reply@jurislpo.com>"

# ── Files ──
UPLOAD_DIR="./storage"

# Background jobs (absence marking, monthly lock, status changes). "false" = run them from cron with `npm run jobs`.
JOBS_ENABLED="true"

# ── Spring Boot backend (backend/, port 8080) — reads this same file ──
# Where the Next.js app finds the API (server-side fetches and the /api/* proxy).
# 127.0.0.1 rather than localhost: Node tries IPv6 (::1) first, which adds a delay on each new connection
BACKEND_URL="http://127.0.0.1:8080"
# Run the scheduled jobs in the backend instead of the Next.js app (switched during the migration).
BACKEND_JOBS_ENABLED="false"
