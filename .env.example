# ── Database (docker-compose maps Postgres to host port 5436) ──
# docker-compose creates the database from these three; DATABASE_URL must use the same values.
POSTGRES_USER="jurisone"
POSTGRES_PASSWORD="<choose-a-strong-password>"
POSTGRES_DB="jurisone"
DATABASE_URL="postgresql://jurisone:<same-password>@localhost:5436/jurisone?schema=public"

# ── App ──
# The public URL of the Next.js app. The API accepts requests (Origin / CORS) only from here.
APP_URL="http://localhost:3005"

# ── Security ──
# 32 random bytes, base64. Encrypts PAN / Aadhaar / UAN / phone / address / bank account at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   (or: openssl rand -base64 32)
# NEVER change this after data exists — encrypted fields become unreadable.
PII_ENCRYPTION_KEY=""
# Signs the 5-minute JWT access tokens (HS256). At least 32 bytes, random; changing it signs everyone out.
# Generate: openssl rand -base64 48
JWT_SECRET="<generate-a-random-secret>"
# How long "Keep me signed in" lasts (the refresh token); without it a sign-in lasts 12 hours.
SESSION_TTL_DAYS=30

# ── Seed (npm run db:seed) ──
# The super admin's password comes only from here — there is no built-in default.
SUPER_ADMIN_EMAIL="admin@jurislpo.com"
SUPER_ADMIN_PASSWORD="<choose-a-strong-password>"  # change it again after the first sign-in
# Demo business (development and tests only): "true" also creates the "Juris Consultants" business with sample people.
SEED_DEMO="false"
# Password for the demo business's owner (sub admin, JC-002). Empty = invite link only.
SEED_OWNER_PASSWORD="<owner-password>"
# Password for every other demo employee (JC-004, JC-012, ...). Empty = invite links only.
SEED_DEMO_PASSWORD="<demo-password>"

# ── Email (leave SMTP_HOST empty in dev: emails are written to the email_outbox table and the server log) ──
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="JurisOne <no-reply@jurislpo.com>"

# ── Files ──
UPLOAD_DIR="./storage"

# Background jobs (absence marking, monthly lock, status changes, leave accrual) run in the backend. "false" = run them from cron.
JOBS_ENABLED="true"

# ── Spring Boot API (backend/, port 8080) — reads this same file ──
# Where the Next.js app finds the API (server-side fetches and the /api/* proxy).
# 127.0.0.1 rather than localhost: Node tries IPv6 (::1) first, which adds a delay on each new connection
BACKEND_URL="http://127.0.0.1:8080"

# ── Sign-in code (email OTP). Fixed to 000000 until the identity provider is connected; set empty for random codes ──
OTP_FIXED_CODE=000000
