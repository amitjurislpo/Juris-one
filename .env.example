# ── Database (docker-compose maps Postgres to host port 5436) ──
DATABASE_URL="postgresql://jurisone:jurisone_dev_pw@localhost:5436/jurisone?schema=public"

# ── App ──
APP_NAME="JurisOne"
APP_URL="http://localhost:3005"
PORT=3005

# ── Security ──
# 32 random bytes, base64. Encrypts PAN / Aadhaar / UAN / phone / address / bank account at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER change this after data exists — encrypted fields become unreadable.
PII_ENCRYPTION_KEY=""
SESSION_TTL_DAYS=30

# ── Seed ──
SUPER_ADMIN_EMAIL="admin@jurislpo.com"
SUPER_ADMIN_PASSWORD="admin@jurislpo"
# Password given to every demo employee (JC-002, JC-004, ...). Leave empty to skip demo passwords (they must use invite links).
SEED_DEMO_PASSWORD="Juris@2026"

# ── Email (leave SMTP_HOST empty in dev: emails are written to the email_outbox table and the server log) ──
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="JurisOne <no-reply@jurislpo.com>"

# ── Files ──
UPLOAD_DIR="./storage"

# Background jobs (absence marking, monthly lock, status changes). "false" = run them from cron with `npm run jobs`.
JOBS_ENABLED="true"
